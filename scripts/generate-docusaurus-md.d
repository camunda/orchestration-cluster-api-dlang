/+ dub.sdl:
name "generate-docusaurus-md"
targetPath ".dub/bin"
+/
/**
Convert the SDK README and generated surface into Docusaurus markdown.

Mirrors the PHP / Rust sibling generators. camunda-docs copies the output of
this program into `docs/apis-tools/d-sdk[.md]`.

Input:
    README.md
    docs/api-reference.md / docs/semantic-types.md  (from generate.d hook 06)
    external-spec/bundled/spec-metadata.json

Output (gitignored; regenerated by `make docs-md`):
    docs-md/d-sdk.md
    docs-md/d-sdk/*.md
    docs-md/d-sdk/api-reference/

Usage:
    dub run -q --single scripts/generate-docusaurus-md.d [-- --validate-links]
*/
module generate_docusaurus_md;

import std.algorithm : canFind, endsWith, map, sort;
import std.array : array, join, replace;
import std.file : dirEntries, exists, mkdirRecurse, readText, remove, rmdirRecurse, SpanMode, write;
import std.format : format;
import std.json : JSONType, JSONValue, parseJSON;
import std.path : baseName, buildNormalizedPath, buildPath, dirName;
import std.process : environment;
import std.regex : ctRegex, matchAll, matchFirst, regex, replaceAll, replaceFirst, Captures;
import std.stdio : stderr, writeln;
import std.string : indexOf, strip, stripLeft, stripRight, toLower, toUpper;

immutable string ROOT;
immutable string README;
immutable string META;
immutable string DOCS_MD;
immutable string SECTION;
immutable string API_REF;
immutable string GITHUB_BLOB;
immutable string GITHUB_TREE;

shared static this()
{
    ROOT = dirName(dirName(__FILE_FULL_PATH__));
    README = buildPath(ROOT, "README.md");
    META = buildPath(ROOT, "external-spec", "bundled", "spec-metadata.json");
    DOCS_MD = buildPath(ROOT, "docs-md");
    SECTION = buildPath(DOCS_MD, "d-sdk");
    API_REF = buildPath(SECTION, "api-reference");
    auto ref_ = environment.get("DOCS_SDK_REF", "");
    if (!ref_.length)
        ref_ = "main";
    GITHUB_BLOB = "https://github.com/camunda/orchestration-cluster-api-dlang/blob/" ~ ref_;
    GITHUB_TREE = "https://github.com/camunda/orchestration-cluster-api-dlang/tree/" ~ ref_;
}

enum LANDING_ID = "d-sdk";
enum LANDING_TITLE = "D SDK (Technical Preview)";
enum API_REFERENCE_POSITION = 100;
enum LANDING_PAGE_DEPTH = 1;
enum SECTION_PAGE_DEPTH = 2;

immutable string[2][] URL_PATH_OVERRIDES = [
    ["camunda-api-rest", "orchestration-cluster-api-rest"],
];

enum TECH_PREVIEW_BANNER =
    "\n:::caution Technical Preview\n"
    ~ "The D SDK is a **technical preview**. Its API surface may still evolve and "
    ~ "changes may not follow semantic versioning. Pin an exact version if you need "
    ~ "stability.\n"
    ~ ":::\n";

string curatedName(string opId)
{
    switch (opId)
    {
    case "getTopology": return "getTopologyOp";
    case "createDeployment": return "createDeploymentOp";
    case "createDocument": return "createDocumentOp";
    case "createDocuments": return "createDocumentsOp";
    default: return opId;
    }
}

string escapeYaml(string s) { return s.replace(`"`, `\"`); }

string slugify(string title)
{
    auto slug = replaceAll(title.toLower, ctRegex!`[^a-z0-9\s_\-]`, "");
    slug = replaceAll(slug.strip, ctRegex!`\s+`, "-");
    return replaceAll(slug, ctRegex!`-+`, "-");
}

string landingFrontmatter()
{
    return "---\n"
        ~ "id: " ~ LANDING_ID ~ "\n"
        ~ `title: "` ~ escapeYaml(LANDING_TITLE) ~ "\"\n"
        ~ `sidebar_label: "` ~ escapeYaml(LANDING_TITLE) ~ "\"\n"
        ~ "sidebar_position: 1\n"
        ~ "mdx:\n"
        ~ "  format: md\n"
        ~ "---\n\n";
}

string sectionFrontmatter(string pageId, string title, size_t position)
{
    return "---\n"
        ~ "id: " ~ pageId ~ "\n"
        ~ `title: "` ~ escapeYaml(title) ~ "\"\n"
        ~ `sidebar_label: "` ~ escapeYaml(title) ~ "\"\n"
        ~ format("sidebar_position: %s\n", position)
        ~ "mdx:\n"
        ~ "  format: md\n"
        ~ "---\n\n";
}

string stripCutSections(string content)
{
    return replaceAll(content, regex(`<!-- docs:cut:start -->.*?<!-- docs:cut:end -->\n?`, "s"), "");
}

string stripHtmlComments(string content)
{
    return replaceAll(content, regex(`^[ \t]*<!--.*?-->[ \t]*\n`, "ms"), "");
}

string stripContributing(string content)
{
    return replaceAll(content, regex(`\n## Contributing\b.*`, "s"), "");
}

string cleanEmptyLines(string content) { return replaceAll(content, ctRegex!`\n{4,}`, "\n\n\n"); }

struct Section
{
    string title, body;
}

/// Split at every line starting with `## `; returns the preamble.
string splitByH2(string content, out Section[] sections)
{
    size_t[] starts;
    foreach (m; matchAll(content, regex(`^## `, "m")))
        starts ~= m.pre.length;
    if (!starts.length)
        return content;
    const preamble = content[0 .. starts[0]];
    foreach (i, s; starts)
    {
        const part = content[s .. i + 1 < starts.length ? starts[i + 1] : $];
        auto m = matchFirst(part, ctRegex!`^## (.+)\n`);
        if (!m.empty)
            sections ~= Section(m[1].strip, part);
    }
    return preamble;
}

string[string] buildAnchorMap(Section[] sections)
{
    string[string] mapping;
    foreach (s; sections)
    {
        const pageSlug = slugify(s.title);
        foreach (m; matchAll(s.body, regex(`^#{2,6}\s+(.+)$`, "m")))
            mapping[slugify(m[1].strip)] = pageSlug;
    }
    return mapping;
}

string rewriteInternalAnchors(string content, string currentSlug, string[string] anchorMap)
{
    return replaceAll!((Captures!string m) {
        if (auto target = m[2] in anchorMap)
            if (*target != currentSlug)
                return "[" ~ m[1] ~ "](" ~ *target ~ ".md#" ~ m[2] ~ ")";
        return m.hit;
    })(content, ctRegex!`\[([^\]]+)\]\(#([^)]+)\)`);
}

string promoteHeadings(string content)
{
    return replaceAll!((Captures!string m) {
        if (m[1].length > 1)
            return m[1][1 .. $] ~ " " ~ m[2];
        return m.hit;
    })(content, regex(`^(#{1,6}) (.+)$`, "m"));
}

string rewriteDocsLinks(string content, int depth)
{
    string prefix;
    foreach (_; 0 .. depth)
        prefix ~= "../";
    return replaceAll!((Captures!string m) {
        auto urlPath = m[2].stripRight("/");
        foreach (o; URL_PATH_OVERRIDES)
            urlPath = urlPath.replace(o[0], o[1]);
        return "[" ~ m[1] ~ "](" ~ prefix ~ urlPath ~ ".md)";
    })(content, ctRegex!`\[([^\]]*)\]\(https?://docs\.camunda\.io/docs/(?:next/)?(.*?)\)`);
}

string rewriteRepoLinks(string content)
{
    return replaceAll!((Captures!string m) {
        const text = m[1], target = m[2];
        if (target.endsWith(".md") && !target.canFind('/'))
            return m.hit;
        const clean = target.stripLeft("./");
        const name = baseName(clean.stripRight("/"));
        const base = clean.endsWith("/") || !name.canFind('.') ? GITHUB_TREE : GITHUB_BLOB;
        return "[" ~ text ~ "](" ~ base ~ "/" ~ clean ~ ")";
    })(content, ctRegex!`\[([^\]]+)\]\((?!https?://|#|mailto:|\.\./)([^)\s]+)\)`);
}

string injectTechPreviewBanner(string content)
{
    auto m = matchFirst(content, regex(`^#\s+.+$`, "m"));
    if (m.empty)
        return content;
    const pos = m.pre.length + m.hit.length;
    return content[0 .. pos] ~ "\n" ~ TECH_PREVIEW_BANNER ~ content[pos .. $];
}

void resetOutput()
{
    if (exists(SECTION))
        rmdirRecurse(SECTION);
    const landing = buildPath(DOCS_MD, "d-sdk.md");
    if (exists(landing))
        remove(landing);
    mkdirRecurse(API_REF);
}

void writeReadmePages()
{
    auto content = readText(README);
    content = stripCutSections(content);
    content = stripHtmlComments(content);
    content = stripContributing(content);
    content = cleanEmptyLines(content);
    content = replaceFirst(content, regex(`^#\s+.*$`, "m"), "# " ~ LANDING_TITLE);
    content = replaceAll(content, regex(`^\[!\[.*?\)$\n?`, "m"), "");
    content = content.strip ~ "\n";

    Section[] sections;
    const preamble = splitByH2(content, sections);
    auto anchorMap = buildAnchorMap(sections);

    auto landing = rewriteDocsLinks(preamble, LANDING_PAGE_DEPTH);
    landing = rewriteRepoLinks(landing);
    landing = injectTechPreviewBanner(landing);
    write(buildPath(DOCS_MD, "d-sdk.md"), landingFrontmatter() ~ cleanEmptyLines(landing).strip ~ "\n");
    writeln("  Wrote landing page docs-md/d-sdk.md");

    foreach (i, s; sections)
    {
        const slug = slugify(s.title);
        auto section = rewriteDocsLinks(s.body, SECTION_PAGE_DEPTH);
        section = rewriteInternalAnchors(section, slug, anchorMap);
        section = rewriteRepoLinks(section);
        auto page = promoteHeadings(section);
        page = injectTechPreviewBanner(page);
        write(buildPath(SECTION, slug ~ ".md"),
            sectionFrontmatter(slug, s.title, i + 2) ~ cleanEmptyLines(page).strip ~ "\n");
        writeln("  Wrote section docs-md/d-sdk/", slug, ".md");
    }
}

string str(JSONValue v, string key, string fallback = "")
{
    if (v.type != JSONType.object)
        return fallback;
    if (auto p = key in v.object)
        if (p.type == JSONType.string && p.str.length)
            return p.str;
    return fallback;
}

/// Raw JSON number text, or null when absent / null.
string num(JSONValue v, string key)
{
    if (v.type != JSONType.object)
        return null;
    auto p = key in v.object;
    if (p is null || p.type == JSONType.null_)
        return null;
    return p.toString;
}

void writeApiReference()
{
    auto meta = parseJSON(readText(META));
    auto operations = meta["operations"].array;
    JSONValue[] keys;
    if (auto k = "semanticKeys" in meta.object)
        if (k.type == JSONType.array)
            keys = k.array;

    JSONValue[][string] byTag;
    foreach (op; operations)
    {
        string tag = "Untagged";
        if (auto t = "tags" in op.object)
            if (t.type == JSONType.array && t.array.length)
                tag = t.array[0].str;
        byTag[tag] ~= op;
    }
    auto tags = byTag.keys.sort.array;

    auto index = sectionFrontmatter("d-sdk-api-reference", "Overview", 0);
    index ~= "# API reference\n\n";
    index ~= ":::caution Technical Preview\n"
        ~ "The D SDK is a **technical preview**. Its API surface may still evolve and "
        ~ "changes may not follow semantic versioning. Pin an exact version if you need "
        ~ "stability.\n:::\n\n";
    index ~= format("The SDK exposes **%s operations** across **%s API groups**. ", operations.length, byTag.length)
        ~ "Every operation is a method on `CamundaClient`:\n\n"
        ~ "```d\n"
        ~ "auto client = CamundaClient.fromEnv();\n"
        ~ "auto topology = client.topology();\n"
        ~ "```\n\n"
        ~ "| API group | Operations |\n| --- | --- |\n";
    foreach (tag; tags)
        index ~= format("| [%s](%s.md) | %s |\n", tag, slugify(tag), byTag[tag].length);
    index ~= "| [Domain type system](domain-type-system.md) | — |\n";
    write(buildPath(API_REF, "index.md"), index ~ "\n");

    foreach (i, tag; tags)
    {
        const slug = slugify(tag);
        auto ops = byTag[tag];
        auto page = sectionFrontmatter(slug, tag, i + 1);
        page ~= "# " ~ tag ~ "\n\n";
        page ~= format("`CamundaClient` — %s operations in this group. ", ops.length)
            ~ "Call any of these directly on the client.\n\n";
        foreach (op; ops)
        {
            const name = curatedName(op["operationId"].str);
            const summary = str(op, "summary").strip;
            auto line = "- `" ~ name ~ "()` (`" ~ str(op, "method", "get").toUpper ~ " " ~ str(op, "path", "/") ~ "`)";
            if (summary.length)
                line ~= " — " ~ summary;
            page ~= line ~ "\n";
        }
        write(buildPath(API_REF, slug ~ ".md"), page ~ "\n");
    }

    auto sem = sectionFrontmatter("domain-type-system", "Domain type system", byTag.length + 1);
    sem ~= "# Domain type system\n\n";
    sem ~= "Each identifier is a distinct D struct in `camunda.generated.keys`. "
        ~ "Construct with `tryNew` (validates) or `assumeExists` (side-load).\n\n"
        ~ "| Type | Pattern | Length | Description |\n| --- | --- | --- |\n";
    foreach (key; keys)
    {
        JSONValue constraints;
        if (auto c = "constraints" in key.object)
            constraints = *c;
        const pattern = str(constraints, "pattern");
        const pat = pattern.length ? "`" ~ pattern ~ "`" : "—";
        const minLen = num(constraints, "minLength");
        const maxLen = num(constraints, "maxLength");
        string length;
        if (minLen !is null && maxLen !is null)
            length = minLen ~ "–" ~ maxLen;
        else if (maxLen !is null)
            length = "≤ " ~ maxLen;
        else if (minLen !is null)
            length = "≥ " ~ minLen;
        else
            length = "—";
        const desc = str(key, "description").replace("\n", " ").replace("|", "\\|").strip;
        sem ~= "| `" ~ key["name"].str ~ "` | " ~ pat ~ " | " ~ length ~ " | " ~ desc ~ " |\n";
    }
    write(buildPath(API_REF, "domain-type-system.md"), sem ~ "\n");

    write(buildPath(API_REF, "_category_.json"),
        format("{\n  \"label\": \"API Reference\",\n  \"position\": %s\n}\n", API_REFERENCE_POSITION));
    writeln(format("  Wrote API reference: index + %s groups + domain-type-system (%s operations)",
        byTag.length, operations.length));
}

void validateLinks()
{
    string[] broken;
    string[] pages = [buildPath(DOCS_MD, "d-sdk.md")];
    foreach (dir; [SECTION, API_REF])
        pages ~= dirEntries(dir, "*.md", SpanMode.shallow).map!(e => e.name).array.sort.array;
    foreach (page; pages)
    {
        const text = readText(page);
        foreach (m; matchAll(text, ctRegex!`\[([^\]]*)\]\((?!https?://|#|mailto:)([^)]+)\)`))
        {
            const hash = m[2].indexOf('#');
            const target = hash < 0 ? m[2] : m[2][0 .. hash];
            if (target == "" || (target.length >= 3 && target[0 .. 3] == "../"))
                continue;
            if (!exists(buildNormalizedPath(dirName(page), target)))
                broken ~= baseName(page) ~ " -> " ~ m[2];
        }
    }
    if (broken.length)
    {
        stderr.writeln("Broken relative links:");
        foreach (b; broken)
            stderr.writeln("  - ", b);
        import core.stdc.stdlib : exit;
        exit(1);
    }
    writeln("  Link validation passed.");
}

int main(string[] argv)
{
    const validate = argv[1 .. $].canFind("--validate-links");
    resetOutput();
    writeReadmePages();
    writeApiReference();
    if (validate)
        validateLinks();
    return 0;
}
